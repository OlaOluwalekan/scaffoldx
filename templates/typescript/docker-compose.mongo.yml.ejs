version: '3.8'

services:
  mongo:
    image: mongo:7
    container_name: <%= appName %>-mongo
    restart: always
    ports:
      - '27017:27017'
    volumes:
      - mongo_data:/data/db
    # Note: For local development, authentication is disabled.
    # For production, enable authentication and configure credentials.

volumes:
  mongo_data:
