{ 
    "name": "<%= appName %>",
    "version": "1.0.0",
    "main": "<%= entryPoint %>.js",
    "scripts": { 
        "start": "node src/<%= entryPoint %>.js", 
        "dev": "nodemon src/<%=entryPoint %>.js",
        "lint": "eslint ."<% if (includeTests) { %>,
        "test": "vitest run"<% } %><% if (useDatabase) { %>,
        "docker:up": "docker compose up -d",
        "docker:down": "docker compose down"<% } %><% if (useDatabase && orm === 'Prisma') { %>,
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:studio": "prisma studio"<% } %>
    },
    "type": "module",
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": "",
    "engines": {
        "node": ">=20.19.0"
    },
    <% if (useDatabase && orm == "Prisma") {%>
    "prisma": {
        "schema": "src/prisma/schema.prisma"
    },
    <% } %>
    "dependencies": {
        "dotenv": "^16.4.5",
        "envalid": "^8.2.0",
        "express": "^4.19.2",
        "cors": "^2.8.5",
        "helmet": "^8.0.0",
        "express-rate-limit": "^7.4.0",
        "morgan": "^1.10.0",
        "express-async-errors": "^3.1.1",
        "http-status-codes": "^2.3.0",
        "swagger-ui-express": "^5.0.1",
        "yamljs": "^0.3.0"
        <% if (useDatabase && orm == "Mongoose") {%>
        ,"mongoose": "^8.6.1"
        <% } %>
        <% if (useDatabase && orm == "Prisma") {%>
        ,"@prisma/client": "<%= databaseType === 'Postgres' ? '^7.10.0' : '^6.19.3' %>"
        <% if (databaseType === 'Postgres') { %>
        ,"@prisma/adapter-pg": "^7.10.0",
        "pg": "^8.23.0"
        <% } %>
        <% } %>
    },
    "devDependencies": {
        "@eslint/js": "^9.11.0",
        "eslint": "^9.11.0",
        "globals": "^15.9.0",
        "nodemon": "^3.1.4"<% if (includeTests) { %>,
        "supertest": "^7.0.0",
        "vitest": "^2.1.1"<% } %>
        <% if (useDatabase && orm == "Prisma") {%>
        ,"prisma": "<%= databaseType === 'Postgres' ? '^7.10.0' : '^6.19.3' %>"
        <% if (databaseType === 'Postgres') { %>
        ,"@types/pg": "^8.23.1"
        <% } %>
        <% } %>
    }
}
